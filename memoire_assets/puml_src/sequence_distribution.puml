@startuml
title Distribution d'engrais — algorithme FIFO
skinparam shadowing true
skinparam roundCorner 12
skinparam DefaultFontName "Segoe UI"
skinparam sequenceMessageAlign center
skinparam ArrowColor #546E7A

actor "Agent" as AGENT
participant "Distribution\nController" as CTRL
participant "Distribution\nService" as SVC
participant "Stock\nService" as STOCK
database "Base de données" as DB
participant "Notification\nService" as MAIL

AGENT -> CTRL : Demander une distribution\n(ticket, dépôt, quantité)
CTRL -> SVC : distribuer(...)

activate SVC
SVC -> DB : Charger le ticket (verrouillé)
DB --> SVC : Ticket
SVC -> DB : Charger le dépôt
DB --> SVC : Dépôt

SVC -> SVC : Vérifier le périmètre de l'agent
SVC -> SVC : Vérifier le statut et le restant du ticket

SVC -> STOCK : sortir les lots en FIFO
activate STOCK
note right of STOCK : du plus ancien\n(dateReceptionFomi)\nau plus récent
STOCK -> DB : Lots disponibles (non périmés)
DB --> STOCK : Liste des lots
STOCK --> SVC : Lots sortis
deactivate STOCK

SVC -> DB : Enregistrer les mouvements\net les distributions
SVC -> SVC : Mettre à jour le ticket\n(PARTIEL ou SERVI)

SVC -> MAIL : Notifier l'agriculteur
note right of MAIL : non bloquant

SVC --> CTRL : Distributions créées
deactivate SVC
CTRL --> AGENT : 200 OK
@enduml
